# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this to .env.production and fill in your actual values
# NEVER commit .env.production to version control

NODE_ENV=production

# ============================================
# SUPABASE (Database + Authentication) — REQUIRED
# ============================================
# Get from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx.xxx

# Server-side only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx.xxx

# ============================================
# STRIPE (Payments) — REQUIRED
# ============================================
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# RESEND (Email Service) — REQUIRED
# ============================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# ============================================
# SITE CONFIGURATION — REQUIRED
# ============================================
NEXT_PUBLIC_SITE_URL=https://your-domain.com
ADMIN_EMAIL=admin@your-domain.com
