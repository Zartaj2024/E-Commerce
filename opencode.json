{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "supabase": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?project_ref=gsohulvooyjodvpsfntp&features=docs,account,database,debugging,development,functions,branching",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--executable-path", "/home/al-malak/.cache/ms-playwright/chromium-1243/chrome-linux64/chrome"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "docker-mcp"],
      "enabled": true
    }
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "bash": {
      "npm *": "allow",
      "npx *": "allow",
      "git *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "cat *": "allow",
      "rm *": "ask",
      "*": "ask"
    },
    "edit": "allow",
    "read": "allow"
  },
  "agent": {
    "build": {
      "steps": 50
    },
    "plan": {
      "steps": 30
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  }
}
